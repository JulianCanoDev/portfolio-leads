# Credenciales del dashboard / API (cambialas después de entrar)
ADMIN_USER=admin
ADMIN_PASS=change_me
# Generar un secret real con: openssl rand -hex 32
JWT_SECRET=change_me

# PostgreSQL (debe coincidir con POSTGRES_* de docker-compose.yml)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=password
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+asyncpg://portfolio:password@postgres:5432/portfolio

# Puerto público del stack (cambialo si 3000 está ocupado, ej. en Dokploy)
HTTP_PORT=3000
