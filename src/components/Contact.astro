---

<section id="contacto">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="sec-kicker">{t('contact.kicker')}</p>
      <h2 class="sec-title">{t('contact.title')}</h2>
      <p class="sec-sub">{t('contact.sub')}</p>
    </div>

    <div class="contact-grid">
      <div class="contact-aside reveal">
        <h3>{t('contact.aside.title')}</h3>
        <p>{t('contact.aside.text')}</p>
        <div class="socials">
          {
            socials.map((social) => (
              <a class="social" href={social!.href} target="_blank" rel="noopener noreferrer">
                <Fragment set:html={social!.svg} />
                <span class="s-label">{social!.label}</span>
                <span class="s-sub">{social!.sub}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="form reveal">
        <form id="contactForm" novalidate>
          <div class="field">
            <label for="name">{t('contact.name')}</label>
            <input id="name" name="name" type="text" placeholder={t('contact.ph.name')} required />
          </div>
          <div class="field">
            <label for="email">{t('contact.email')}</label>
            <input id="email" name="email" type="email" placeholder={t('contact.ph.email')} required />
          </div>
          <div class="field">
            <label for="whatsapp">{t('contact.whatsapp')}</label>
            <div class="input-row">
              <input type="hidden" id="countryCode" name="countryCode" value="+57" />
              <div class="cc-wrap">
                <button type="button" class="cc-btn" id="ccBtn" aria-haspopup="listbox" aria-expanded="false">
                  <img class="cc-flag" id="ccFlag" src="https://flagcdn.com/w40/co.png" alt="" width="22" height="15" />
                  <span id="ccLabel">CO +57</span>
                  <span class="cc-caret">▾</span>
                </button>
                <div class="cc-panel" id="ccPanel" role="listbox" aria-label="Country code" hidden></div>
              </div>
              <input id="whatsapp" name="whatsapp" type="tel" placeholder={t('contact.ph.whatsapp')} pattern="[0-9]{7,15}" />
            </div>
          </div>
          <div class="field">
            <label for="message">{t('contact.message')}</label>
            <textarea id="message" name="message" placeholder={t('contact.ph.message')} required></textarea>
          </div>
          <div class="form-foot">
            <button class="btn btn-primary" type="submit">
              {t('contact.send')}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
            <span class="form-status" id="formStatus"></span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap foot-inner">
    <p>© {new Date().getFullYear()} {settings.name} — {roleTitle}</p>
  </div>
  <div class="wrap foot-credit">
    <p>{t('foot.made', { name: settings.name })}</p>
  </div>
</footer>

<script type="application/json" id="cc-data" is:inline set:html={JSON.stringify(CC_COUNTRIES)} />
<script>
  import { t } from '../i18n/index';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;

  // Custom country-code dropdown with real flag images (emoji flags don't
  // render on Windows). Syncs the hidden #countryCode input so the submit
  // handler keeps working unchanged.
  const ccBtn = document.getElementById('ccBtn') as HTMLButtonElement;
  const ccPanel = document.getElementById('ccPanel')!;
  const ccFlag = document.getElementById('ccFlag') as HTMLImageElement;
  const ccLabel = document.getElementById('ccLabel')!;
  const ccInput = document.getElementById('countryCode') as HTMLInputElement;
  const CC_DATA: { code: string; iso: string; flag: string }[] = JSON.parse(
    document.getElementById('cc-data')?.textContent ?? '[]',
  );

  let ccBuilt = false;
  function buildPanel() {
    if (ccBuilt) return;
    ccBuilt = true;
    for (const c of CC_DATA) {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'cc-item';
      item.dataset.code = c.code;
      const img = document.createElement('img');
      img.src = `https://${c.flag}`;
      img.alt = '';
      img.width = 22;
      img.height = 15;
      img.loading = 'lazy';
      const label = document.createElement('span');
      label.textContent = `${c.iso} ${c.code}`;
      item.append(img, label);
      item.addEventListener('click', () => {
        ccInput.value = c.code;
        ccFlag.src = `https://${c.flag}`;
        ccLabel.textContent = `${c.iso} ${c.code}`;
        closeCc();
      });
      ccPanel.appendChild(item);
    }
  }

  function openCc() {
    buildPanel();
    ccPanel.hidden = false;
    ccBtn.setAttribute('aria-expanded', 'true');
  }
  function closeCc() {
    ccPanel.hidden = true;
    ccBtn.setAttribute('aria-expanded', 'false');
  }

  ccBtn.addEventListener('click', () => (ccPanel.hidden ? openCc() : closeCc()));

  // WhatsApp input: solo dígitos, largo esperado por país (CO = 10)
  const waInput = document.getElementById('whatsapp') as HTMLInputElement | null;
  const WA_LENGTHS: Record<string, [number, number]> = {
    CO: [10, 10], MX: [10, 10], US: [10, 10], CA: [10, 10],
    ES: [9, 9], CL: [9, 9], PE: [9, 9], AR: [10, 11], BR: [10, 11],
    UY: [8, 9], VE: [10, 10], EC: [9, 10], BO: [8, 8], PY: [9, 10],
    GB: [10, 10], DE: [10, 11], FR: [9, 9], IT: [9, 11],
  };

  function waIso(): string {
    const code = ccInput.value;
    const hit = CC_DATA.find((c) => c.code === code);
    return hit?.iso ?? '';
  }

  function waValidate(): boolean {
    if (!waInput || !status) return true;
    const raw = waInput.value.replace(/\D/g, '');
    if (!raw) {
      status.textContent = '';
      return true;
    }
    const [min, max] = WA_LENGTHS[waIso()] ?? [7, 15];
    if (raw.length < min || raw.length > max) {
      status.textContent = t('contact.wa.error', { iso: waIso() || '?', min, max });
      status.style.color = '#fbbf24';
      status.classList.add('show');
      return false;
    }
    status.textContent = '';
    return true;
  }

  waInput?.addEventListener('input', () => {
    const digits = waInput.value.replace(/\D/g, '').slice(0, 15);
    waInput.value = digits;
    waValidate();
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!ccPanel.hidden && !target.closest('.input-row')) closeCc();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !ccPanel.hidden) closeCc();
  });
  const status = document.getElementById('formStatus');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = form.name.value.trim();
    const email = form.email.value.trim();
    const msg = form.message.value.trim();
    if (!waValidate()) return;
    const cc = form.countryCode?.value || '+57';
    const waRaw = form.whatsapp?.value.trim() ?? '';
    const fullWa = waRaw ? cc + waRaw.replace(/^\+/, '') : undefined;

    if (!name || !email || !msg) {
      if (status) {
        status.textContent = t('contact.required');
        status.style.color = '#fbbf24';
        status.classList.add('show');
      }
      return;
    }

    if (status) {
      status.textContent = t('contact.sending');
      status.style.color = '#9b9bab';
      status.classList.add('show');
    }
    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, email, message: msg, whatsapp: fullWa }),
      });
      if (!res.ok) throw new Error(String(res.status));
      if (status) {
        status.textContent = t('contact.thanks');
        status.style.color = 'var(--secondary-soft)';
      }
      form.reset();
    } catch {
      if (status) {
        status.textContent = t('contact.error');
        status.style.color = '#fbbf24';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
