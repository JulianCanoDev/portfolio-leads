---
interface Props {
  src: string;
  alt: string;
  className?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, className, loading = 'lazy' } = Astro.props;

// Last-resort inline placeholder (dark surface with a dot) for images that
// fail entirely — URL-encoded tiny SVG, no extra request.
const PLACEHOLDER =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 10'%3E%3Crect width='16' height='10' fill='%230d0d16'/%3E%3Ccircle cx='8' cy='5' r='1.6' fill='%236d28d9' opacity='.7'/%3E%3C/svg%3E";

const isWebp = src.toLowerCase().endsWith('.webp');
const jpgVariant = isWebp ? src.replace(/\.webp$/i, '.jpg') : src;
---

{
  isWebp ? (
    <picture>
      <source srcset={src} type="image/webp" />
      <source srcset={jpgVariant} type="image/jpeg" />
      <img
        src={src}
        alt={alt}
        class={className}
        loading={loading}
        decoding="async"
        onerror={`this.onerror=function(){this.onerror=null;this.src='${PLACEHOLDER}'};this.src='${jpgVariant}'`}
      />
    </picture>
  ) : (
    <img src={src} alt={alt} class={className} loading={loading} decoding="async" />
  )
}
