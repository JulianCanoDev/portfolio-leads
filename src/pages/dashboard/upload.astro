---
import DashboardLayout from '../../components/DashboardLayout.astro';
import { useI18n } from '../../i18n/index';

const token = Astro.cookies.get('julixr_token')?.value;
if (!token) {
  return Astro.redirect('/dashboard/login');
}

const { t } = useI18n(Astro);
---

<DashboardLayout title={t('up.title')} active="upload">
  <div class="dash-head">
    <div>
      <p class="sec-kicker">{t('set.kicker')}</p>
      <h1 class="dash-title">{t('up.title')}</h1>
      <p class="dash-sub">{t('up.sub')}</p>
    </div>
  </div>

  <div class="dz" id="dz">
    <input type="file" id="dzInput" accept="image/*" hidden />
    <div class="dz-inner" id="dzInner">
      <span class="dz-icon">⬆</span>
      <p class="dz-title">{t('up.dz.title')}</p>
      <p class="dz-sub" set:html={t('up.dz.hint', { link: `<button class="dz-browse" type="button" id="dzBrowse">${t('up.dz.browse')}</button>` })} />
    </div>
    <div class="dz-result" id="dzResult" hidden>
      <img id="dzPreview" alt="" />
      <div class="dz-url-row">
        <input id="dzUrl" type="text" readonly aria-label="URL" />
        <button class="tool-btn" type="button" id="dzCopy">{t('up.copy')}</button>
      </div>
      <p class="dz-note" id="dzNote"></p>
    </div>
    <p class="dz-status" id="dzStatus"></p>
  </div>
</DashboardLayout>

<script>
  import { t } from '../../i18n/index';

  const dz = document.getElementById('dz')!;
  const input = document.getElementById('dzInput') as HTMLInputElement;
  const inner = document.getElementById('dzInner')!;
  const result = document.getElementById('dzResult') as HTMLElement;
  const preview = document.getElementById('dzPreview') as HTMLImageElement;
  const urlField = document.getElementById('dzUrl') as HTMLInputElement;
  const status = document.getElementById('dzStatus')!;
  const note = document.getElementById('dzNote')!;
  const copyBtn = document.getElementById('dzCopy') as HTMLButtonElement;

  document.getElementById('dzBrowse')?.addEventListener('click', () => input.click());
  inner.addEventListener('click', () => input.click());
  input.addEventListener('change', () => {
    if (input.files?.[0]) upload(input.files[0]);
  });

  ['dragenter', 'dragover'].forEach((evt) =>
    dz.addEventListener(evt, (e) => {
      e.preventDefault();
      dz.classList.add('over');
    }),
  );
  ['dragleave', 'drop'].forEach((evt) =>
    dz.addEventListener(evt, (e) => {
      e.preventDefault();
      dz.classList.remove('over');
    }),
  );
  dz.addEventListener('drop', (e) => {
    const file = e.dataTransfer?.files?.[0];
    if (file) upload(file);
  });

  async function upload(file: File) {
    status.textContent = t('up.processing', { name: file.name });
    status.style.color = '#9b9bab';
    result.hidden = true;
    try {
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/upload', { method: 'POST', credentials: 'same-origin', body: fd });
      const data = (await res.json()) as { url?: string; detail?: string };
      if (!res.ok || !data.url) throw new Error(data.detail ?? 'error');
      urlField.value = data.url;
      preview.src = data.url;
      result.hidden = false;
      status.textContent = t('up.done');
      status.style.color = 'var(--secondary-soft)';
      note.textContent = t('up.note');
    } catch (err) {
      status.textContent = err instanceof Error && err.message && err.message !== 'error' ? err.message : t('up.error');
      status.style.color = '#fbbf24';
    }
  }

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(urlField.value).catch(() => {});
    copyBtn.textContent = t('up.copied');
    setTimeout(() => (copyBtn.textContent = t('up.copy')), 1500);
  });
</script>
