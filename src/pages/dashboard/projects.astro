---
import DashboardLayout from '../../components/DashboardLayout.astro';
import { useI18n } from '../../i18n/index';

const token = Astro.cookies.get('julixr_token')?.value;
if (!token) {
  return Astro.redirect('/dashboard/login');
}

const { t } = useI18n(Astro);
---

<DashboardLayout title={t('padmin.title')} active="projects">
  <div class="dash-head">
    <div>
      <p class="sec-kicker">{t('set.kicker')}</p>
      <h1 class="dash-title">{t('padmin.title')}</h1>
      <p class="dash-sub">{t('padmin.sub')}</p>
    </div>
    <div class="dash-tools">
      <button class="tool-btn" type="button" id="newBtn">{t('padmin.new')}</button>
    </div>
  </div>

  <div class="proj-list" id="projList">
    <p class="proj-loading">{t('padmin.loading')}</p>
  </div>

  <section class="proj-editor" id="editor" hidden>
    <h2 class="editor-title" id="editorTitle">{t('padmin.editor.new')}</h2>
    <form class="form" id="projForm">
      <div class="lang-toggle editor-lang" role="group" aria-label="Language">
        <button class="lang-btn active" type="button" data-form-lang="es">ES</button>
        <span class="lang-sep">/</span>
        <button class="lang-btn" type="button" data-form-lang="en">EN</button>
      </div>

      <div class="form-lang" data-lang-pane="es">
        <div class="field">
          <label for="p_title_es">{t('padmin.f.title')} (ES)</label>
          <input id="p_title_es" type="text" maxlength="200" required />
        </div>
        <div class="field">
          <label for="p_category_es">{t('padmin.f.category')} (ES)</label>
          <input id="p_category_es" type="text" maxlength="100" placeholder={t('padmin.f.category.ph')} />
        </div>
        <div class="field">
          <label for="p_challenge_es">{t('padmin.f.challenge')} (ES)</label>
          <textarea id="p_challenge_es" maxlength="5000"></textarea>
        </div>
        <div class="field">
          <label for="p_solution_es">{t('padmin.f.solution')} (ES)</label>
          <textarea id="p_solution_es" maxlength="5000"></textarea>
        </div>
      </div>

      <div class="form-lang" data-lang-pane="en" hidden>
        <div class="field">
          <label for="p_title_en">{t('padmin.f.title')} (EN)</label>
          <input id="p_title_en" type="text" maxlength="200" />
        </div>
        <div class="field">
          <label for="p_category_en">{t('padmin.f.category')} (EN)</label>
          <input id="p_category_en" type="text" maxlength="100" />
        </div>
        <div class="field">
          <label for="p_challenge_en">{t('padmin.f.challenge')} (EN)</label>
          <textarea id="p_challenge_en" maxlength="5000"></textarea>
        </div>
        <div class="field">
          <label for="p_solution_en">{t('padmin.f.solution')} (EN)</label>
          <textarea id="p_solution_en" maxlength="5000"></textarea>
        </div>
      </div>

      <div class="field">
        <label for="p_stack">{t('padmin.f.stack')}</label>
        <input id="p_stack" type="text" maxlength="2000" placeholder={t('padmin.f.stack.ph')} />
      </div>
      <div class="field">
        <label for="p_tag_input">{t('padmin.f.tags')}</label>
        <div class="chip-input" id="chipBox">
          <span class="chips" id="tagChips"></span>
          <input id="p_tag_input" type="text" placeholder={t('padmin.f.tags.ph')} />
        </div>
      </div>
      <div class="color-row">
        <div class="field color-field">
          <label for="p_color">{t('padmin.f.color')}</label>
          <div class="color-input">
            <input id="p_color" type="color" value="#6d28d9" />
            <input id="p_color_hex" type="text" maxlength="7" aria-label="Hex" />
          </div>
        </div>
      </div>
      <div class="field">
        <label for="p_image">{t('padmin.f.image')}</label>
        <div class="img-pick">
          <img id="p_image_preview" alt="" hidden />
          <input id="p_image" type="file" accept="image/*" />
        </div>
      </div>
      <div class="form-foot">
        <button class="btn btn-primary" type="submit" id="saveProjBtn">{t('padmin.save')}</button>
        <button class="tool-btn" type="button" id="cancelBtn">{t('padmin.cancel')}</button>
        <span class="form-status" id="projStatus"></span>
      </div>
    </form>
  </section>
</DashboardLayout>

<script>
  import { t } from '../../i18n/index';

  interface Localized {
    es: string | null;
    en: string | null;
  }

  interface Project {
    id: number;
    title: Localized;
    category: Localized;
    challenge: Localized;
    solution: Localized;
    stack: string | null;
    tags: string[];
    image_url: string | null;
    color: string | null;
  }

  const list = document.getElementById('projList')!;
  const editor = document.getElementById('editor') as HTMLElement;
  const editorTitle = document.getElementById('editorTitle')!;
  const form = document.getElementById('projForm') as HTMLFormElement;
  const status = document.getElementById('projStatus');
  const saveBtn = document.getElementById('saveProjBtn') as HTMLButtonElement;

  const el = (id: string) => document.getElementById(id) as HTMLInputElement;

  const f = {
    title_es: el('p_title_es'),
    title_en: el('p_title_en'),
    category_es: el('p_category_es'),
    category_en: el('p_category_en'),
    challenge_es: el('p_challenge_es') as HTMLTextAreaElement,
    challenge_en: el('p_challenge_en') as HTMLTextAreaElement,
    solution_es: el('p_solution_es') as HTMLTextAreaElement,
    solution_en: el('p_solution_en') as HTMLTextAreaElement,
    stack: el('p_stack'),
    image: el('p_image'),
    tagInput: el('p_tag_input'),
    color: el('p_color'),
    colorHex: el('p_color_hex'),
  };

  const chipsBox = document.getElementById('tagChips')!;
  const preview = document.getElementById('p_image_preview') as HTMLImageElement;

  let projects: Project[] = [];
  let editingId: number | null = null;
  let tags: string[] = [];
  let pendingFile: File | null = null;
  let keepImageUrl: string | null = null;

  // ES/EN form toggle — switches the visible pane (acts as per-language preview)
  document.querySelectorAll<HTMLButtonElement>('[data-form-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.formLang === 'en' ? 'en' : 'es';
      document.querySelectorAll<HTMLButtonElement>('[data-form-lang]').forEach((b) =>
        b.classList.toggle('active', b === btn),
      );
      document.querySelectorAll<HTMLElement>('[data-lang-pane]').forEach((pane) => {
        pane.hidden = pane.dataset.langPane !== lang;
      });
    });
  });

  function showStatus(text: string, color: string) {
    if (status) {
      status.textContent = text;
      status.style.color = color;
      status.classList.add('show');
    }
  }

  function renderChips() {
    chipsBox.innerHTML = '';
    tags.forEach((tag, i) => {
      const chip = document.createElement('span');
      chip.className = 'chip removable';
      chip.textContent = tag;
      const x = document.createElement('button');
      x.type = 'button';
      x.textContent = '×';
      x.addEventListener('click', () => {
        tags.splice(i, 1);
        renderChips();
      });
      chip.appendChild(x);
      chipsBox.appendChild(chip);
    });
  }

  function addTag(raw: string) {
    const tag = raw.trim().replace(/,+$/, '');
    if (tag && !tags.includes(tag) && tags.length < 20) {
      tags.push(tag);
      renderChips();
    }
  }

  f.tagInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      addTag(f.tagInput.value);
      f.tagInput.value = '';
    }
  });
  f.tagInput.addEventListener('blur', () => {
    if (f.tagInput.value) {
      addTag(f.tagInput.value);
      f.tagInput.value = '';
    }
  });

  f.image.addEventListener('change', () => {
    pendingFile = f.image.files?.[0] ?? null;
    if (pendingFile) {
      preview.src = URL.createObjectURL(pendingFile);
      preview.hidden = false;
    }
  });

  f.color.addEventListener('input', () => {
    f.colorHex.value = f.color.value;
  });
  f.colorHex.addEventListener('input', () => {
    if (/^#[0-9a-fA-F]{6}$/.test(f.colorHex.value)) f.color.value = f.colorHex.value.toLowerCase();
  });

  function openEditor(project: Project | null) {
    editingId = project?.id ?? null;
    editorTitle.textContent = project
      ? t('padmin.editor.edit', { title: project.title.es ?? '' })
      : t('padmin.editor.new');
    const set = (input: HTMLInputElement | HTMLTextAreaElement, v: string | null) => {
      input.value = v ?? '';
    };
    set(f.title_es, project?.title.es ?? '');
    set(f.title_en, project?.title.en ?? '');
    set(f.category_es, project?.category.es ?? '');
    set(f.category_en, project?.category.en ?? '');
    set(f.challenge_es, project?.challenge.es ?? '');
    set(f.challenge_en, project?.challenge.en ?? '');
    set(f.solution_es, project?.solution.es ?? '');
    set(f.solution_en, project?.solution.en ?? '');
    f.stack.value = project?.stack ?? '';
    tags = project ? [...project.tags] : [];
    renderChips();
    pendingFile = null;
    f.image.value = '';
    keepImageUrl = project?.image_url ?? null;
    preview.src = keepImageUrl ?? '';
    preview.hidden = !keepImageUrl;
    const color = project?.color ?? '#6d28d9';
    f.color.value = color;
    f.colorHex.value = color;
    showStatus('', '');
    editor.hidden = false;
    editor.scrollIntoView({ behavior: 'smooth' });
    f.title_es.focus();
  }

  document.getElementById('newBtn')?.addEventListener('click', () => openEditor(null));
  document.getElementById('cancelBtn')?.addEventListener('click', () => {
    editor.hidden = true;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!f.title_es.value.trim()) return;
    saveBtn.disabled = true;
    showStatus(t('padmin.saving'), '#9b9bab');

    let image_url = keepImageUrl;
    try {
      if (pendingFile) {
        const fd = new FormData();
        fd.append('file', pendingFile);
        const up = await fetch('/api/upload', { method: 'POST', credentials: 'same-origin', body: fd });
        if (!up.ok) throw new Error('upload');
        image_url = ((await up.json()) as { url: string }).url;
      }

      const body = {
        title_es: f.title_es.value.trim(),
        title_en: f.title_en.value.trim() || null,
        category_es: f.category_es.value.trim() || 'Web',
        category_en: f.category_en.value.trim() || null,
        challenge_es: f.challenge_es.value.trim() || null,
        challenge_en: f.challenge_en.value.trim() || null,
        solution_es: f.solution_es.value.trim() || null,
        solution_en: f.solution_en.value.trim() || null,
        stack: f.stack.value.trim() || null,
        tags,
        image_url,
        color: f.color.value,
      };
      const res = await fetch(editingId ? `/api/projects/${editingId}` : '/api/projects', {
        method: editingId ? 'PUT' : 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(String(res.status));

      editor.hidden = true;
      await load();
    } catch {
      showStatus(t('padmin.error'), '#fbbf24');
    } finally {
      saveBtn.disabled = false;
    }
  });

  async function load() {
    const res = await fetch('/api/projects', { credentials: 'same-origin' });
    projects = (await res.json()) as Project[];
    render();
  }

  function render() {
    list.innerHTML = '';
    if (projects.length === 0) {
      list.innerHTML = `<p class="proj-loading">${t('padmin.empty')}</p>`;
      return;
    }
    projects.forEach((project) => {
      const row = document.createElement('article');
      row.className = 'proj-row';
      row.draggable = true;
      row.dataset.id = project.id;

      const handle = document.createElement('span');
      handle.className = 'drag-handle';
      handle.title = t('padmin.sub');
      handle.textContent = '⠿';

      const thumb = document.createElement('div');
      thumb.className = 'proj-thumb';
      if (project.image_url) {
        const img = document.createElement('img');
        img.src = project.image_url;
        img.alt = project.title.es ?? '';
        thumb.appendChild(img);
      }

      const info = document.createElement('div');
      info.className = 'proj-info';
      const title = document.createElement('h3');
      title.textContent = project.title.es ?? '';
      const cat = document.createElement('span');
      cat.className = 'cat ai';
      if (project.color) {
        cat.style.color = project.color;
        cat.style.borderColor = `${project.color}55`;
        cat.style.background = `${project.color}1f`;
      }
      cat.textContent = project.category.es ?? '';
      info.append(title, cat);

      const actions = document.createElement('div');
      actions.className = 'proj-actions';
      const editBtn = document.createElement('button');
      editBtn.className = 'mark-btn';
      editBtn.textContent = t('padmin.edit');
      editBtn.addEventListener('click', () => openEditor(project));
      const delBtn = document.createElement('button');
      delBtn.className = 'del-btn';
      delBtn.textContent = '×';
      delBtn.title = t('padmin.delete');
      delBtn.addEventListener('click', async () => {
        if (!window.confirm(t('padmin.confirm.delete', { title: project.title.es ?? '' }))) return;
        delBtn.disabled = true;
        const res = await fetch(`/api/projects/${project.id}`, { method: 'DELETE', credentials: 'same-origin' });
        if (res.ok) await load();
        else delBtn.disabled = false;
      });
      actions.append(editBtn, delBtn);

      row.append(handle, thumb, info, actions);
      list.appendChild(row);
    });
  }

  let dragId: number | null = null;
  list.addEventListener('dragstart', (e) => {
    const row = (e.target as HTMLElement).closest('.proj-row');
    if (!row) return;
    dragId = Number(row.dataset.id);
    row.classList.add('dragging');
  });
  list.addEventListener('dragend', (e) => {
    const row = (e.target as HTMLElement).closest('.proj-row');
    row?.classList.remove('dragging');
    dragId = null;
  });
  list.addEventListener('dragover', (e) => {
    e.preventDefault();
    const row = (e.target as HTMLElement).closest('.proj-row');
    const dragging = list.querySelector('.dragging');
    if (!row || !dragging || row === dragging) return;
    const rect = row.getBoundingClientRect();
    const after = e.clientY > rect.top + rect.height / 2;
    list.insertBefore(dragging, after ? row.nextSibling : row);
  });
  list.addEventListener('drop', async (e) => {
    e.preventDefault();
    const order = Array.from(list.querySelectorAll('.proj-row')).map((row) => Number((row as HTMLElement).dataset.id));
    if (order.length < 2) return;
    await fetch('/api/projects/reorder', {
      method: 'PATCH',
      headers: { 'content-type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ order }),
    });
    await load();
  });

  await load();
</script>
