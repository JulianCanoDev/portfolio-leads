---
import DashboardLayout from '../../components/DashboardLayout.astro';
import { useI18n } from '../../i18n/index';

const token = Astro.cookies.get('julixr_token')?.value;
if (!token) {
  return Astro.redirect('/dashboard/login');
}

const { t } = useI18n(Astro);
---

<DashboardLayout title={t('set.title')} active="settings">
  <div class="dash-head">
    <div>
      <p class="sec-kicker">{t('set.kicker')}</p>
      <h1 class="dash-title">{t('set.title')}</h1>
      <p class="dash-sub">{t('set.sub')}</p>
    </div>
  </div>

  <div class="settings-grid">
    <form class="form settings-form" id="settingsForm">
      <div class="field">
        <label for="name">{t('set.name')}</label>
        <input id="name" name="name" type="text" maxlength="100" required />
      </div>
      <div class="field">
        <label for="role_title">{t('set.role')}</label>
        <input id="role_title" name="role_title" type="text" maxlength="200" required />
      </div>
      <div class="field">
        <label for="tagline_es">{t('set.tagline')} (ES)</label>
        <textarea id="tagline_es" name="tagline_es" maxlength="1000"></textarea>
      </div>
      <div class="field">
        <label for="tagline_en">{t('set.tagline')} (EN)</label>
        <textarea id="tagline_en" name="tagline_en" maxlength="1000"></textarea>
      </div>
      <div class="field">
        <label for="description_es">{t('set.description')} (ES)</label>
        <textarea id="description_es" name="description_es" maxlength="2000"></textarea>
      </div>
      <div class="field">
        <label for="description_en">{t('set.description')} (EN)</label>
        <textarea id="description_en" name="description_en" maxlength="2000"></textarea>
      </div>

      <div class="color-row">
        <div class="field color-field">
          <label for="accent_color">{t('set.accent')}</label>
          <div class="color-input">
            <input id="accent_color" name="accent_color" type="color" />
            <input id="accent_hex" type="text" maxlength="7" aria-label="Hex accent" />
          </div>
        </div>
        <div class="field color-field">
          <label for="secondary_color">{t('set.secondary')}</label>
          <div class="color-input">
            <input id="secondary_color" name="secondary_color" type="color" />
            <input id="secondary_hex" type="text" maxlength="7" aria-label="Hex secondary" />
          </div>
        </div>
      </div>

      <div class="field">
        <label for="linkedin_url">{t('set.linkedin')}</label>
        <input id="linkedin_url" name="linkedin_url" type="url" placeholder="https://www.linkedin.com/in/..." />
      </div>
      <div class="field">
        <label for="github_url">{t('set.github')}</label>
        <input id="github_url" name="github_url" type="url" placeholder="https://github.com/..." />
      </div>
      <div class="field">
        <label for="whatsapp_phone">{t('set.whatsapp')}</label>
        <input id="whatsapp_phone" name="whatsapp_phone" type="text" maxlength="50" placeholder="573001112233" />
      </div>

      <div class="field">
        <label for="skill_input">{t('set.skills')}</label>
        <div class="chip-input" id="skillChipBox">
          <span class="chips" id="skillChips"></span>
          <input id="skill_input" type="text" placeholder={t('set.skills.ph')} />
        </div>
      </div>

      <div class="field">
        <label for="cv_file">{t('set.cv')}</label>
        <p class="field-hint">{t('set.cv.hint')}</p>
        <div class="cv-upload">
          <div class="cv-box" id="cvCurrent">
            <span class="cv-ico">📄</span>
            <span class="cv-meta" id="cvMeta">CV_Julian_Cano.pdf</span>
          </div>
          <input type="file" id="cv_file" accept="application/pdf,.pdf" hidden />
          <button class="tool-btn" type="button" id="cvPick">{t('set.cv')}</button>
          <button class="btn btn-primary" type="button" id="cvReplace" hidden>{t('set.cv.replace')}</button>
          <span class="form-status" id="cvStatus"></span>
        </div>
      </div>

      <div class="form-foot">
        <button class="btn btn-primary" type="submit" id="saveBtn">{t('set.save')}</button>
        <button class="tool-btn" type="button" id="resetBtn">{t('set.reset')}</button>
        <span class="form-status" id="settingsStatus"></span>
      </div>
    </form>

    <aside class="preview-card" id="heroPreview">
      <p class="preview-label">{t('set.preview')}</p>
      <div class="preview-hero">
        <span class="eyebrow"><span class="pulse-dot"></span>{t('hero.eyebrow')}</span>
        <h1 class="preview-name" id="pvName"></h1>
        <p class="preview-role" id="pvRole"></p>
        <p class="preview-tagline" id="pvTagline"></p>
        <span class="btn btn-primary preview-btn">{t('hero.cta.projects')}</span>
      </div>
    </aside>
  </div>
</DashboardLayout>

<script>
  import { t } from '../../i18n/index';

  const form = document.getElementById('settingsForm') as HTMLFormElement;
  const status = document.getElementById('settingsStatus');
  const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;

  const inputs = {
    name: document.getElementById('name') as HTMLInputElement,
    role_title: document.getElementById('role_title') as HTMLInputElement,
    tagline_es: document.getElementById('tagline_es') as HTMLTextAreaElement,
    tagline_en: document.getElementById('tagline_en') as HTMLTextAreaElement,
    description_es: document.getElementById('description_es') as HTMLTextAreaElement,
    description_en: document.getElementById('description_en') as HTMLTextAreaElement,
    linkedin_url: document.getElementById('linkedin_url') as HTMLInputElement,
    github_url: document.getElementById('github_url') as HTMLInputElement,
    whatsapp_phone: document.getElementById('whatsapp_phone') as HTMLInputElement,
  };
  const accent = document.getElementById('accent_color') as HTMLInputElement;
  const secondary = document.getElementById('secondary_color') as HTMLInputElement;
  const accentHex = document.getElementById('accent_hex') as HTMLInputElement;
  const secondaryHex = document.getElementById('secondary_hex') as HTMLInputElement;

  const pvName = document.getElementById('pvName')!;
  const pvRole = document.getElementById('pvRole')!;
  const pvTagline = document.getElementById('pvTagline')!;
  const preview = document.getElementById('heroPreview')!;

  let skills: string[] = [];
  const skillChips = document.getElementById('skillChips')!;
  const skillInput = document.getElementById('skill_input') as HTMLInputElement;

  function renderSkillChips() {
    skillChips.innerHTML = '';
    skills.forEach((skill, i) => {
      const chip = document.createElement('span');
      chip.className = 'chip removable';
      chip.textContent = skill;
      const x = document.createElement('button');
      x.type = 'button';
      x.textContent = '×';
      x.addEventListener('click', () => {
        skills.splice(i, 1);
        renderSkillChips();
      });
      chip.appendChild(x);
      skillChips.appendChild(chip);
    });
  }

  function addSkill(raw: string) {
    const skill = raw.trim().replace(/,+$/, '');
    if (skill && !skills.includes(skill) && skills.length < 50) {
      skills.push(skill);
      renderSkillChips();
    }
  }

  skillInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      addSkill(skillInput.value);
      skillInput.value = '';
    }
  });
  skillInput.addEventListener('blur', () => {
    if (skillInput.value) {
      addSkill(skillInput.value);
      skillInput.value = '';
    }
  });

  function towardWhite(hex: string, amount: number): string {
    const ch = (start: number) =>
      Math.round(start + (255 - start) * amount)
        .toString(16)
        .padStart(2, '0');
    return `#${ch(parseInt(hex.slice(1, 3), 16))}${ch(parseInt(hex.slice(3, 5), 16))}${ch(parseInt(hex.slice(5, 7), 16))}`;
  }

  function refreshPreview() {
    pvName.textContent = inputs.name.value || '—';
    pvRole.textContent = inputs.role_title.value || '';
    pvTagline.textContent = inputs.tagline_es.value || inputs.tagline_en.value || '';
    preview.style.setProperty('--accent', accent.value);
    preview.style.setProperty('--accent-glow', towardWhite(accent.value, 0.28));
    preview.style.setProperty('--accent-soft', towardWhite(accent.value, 0.6));
    preview.style.setProperty('--secondary', secondary.value);
    preview.style.setProperty('--secondary-soft', towardWhite(secondary.value, 0.4));
  }

  function syncHex(picker: HTMLInputElement, hexField: HTMLInputElement) {
    picker.addEventListener('input', () => {
      hexField.value = picker.value;
      refreshPreview();
    });
    hexField.addEventListener('input', () => {
      if (/^#[0-9a-fA-F]{6}$/.test(hexField.value)) {
        picker.value = hexField.value.toLowerCase();
        refreshPreview();
      }
    });
  }

  Object.values(inputs).forEach((input) => input.addEventListener('input', refreshPreview));
  syncHex(accent, accentHex);
  syncHex(secondary, secondaryHex);

  function fill(data: Record<string, unknown>) {
    for (const [key, input] of Object.entries(inputs)) {
      if (key.endsWith('_es') || key.endsWith('_en')) {
        const base = key.slice(0, -3);
        const loc = key.slice(-2);
        const localized = data[base] as { es?: string; en?: string } | undefined;
        input.value = localized?.[loc] ?? '';
        continue;
      }
      input.value = (data[key] as string) ?? '';
    }
    skills = Array.isArray(data.skills) ? (data.skills as string[]) : [];
    renderSkillChips();
    accent.value = /^#[0-9a-fA-F]{6}$/.test(data.accent_color ?? '') ? (data.accent_color as string) : '#6d28d9';
    secondary.value = /^#[0-9a-fA-F]{6}$/.test(data.secondary_color ?? '') ? (data.secondary_color as string) : '#0d9488';
    accentHex.value = accent.value;
    secondaryHex.value = secondary.value;
    refreshPreview();
  }

  fill(await (await fetch('/api/settings', { credentials: 'same-origin' })).json());

  function showStatus(text: string, color: string) {
    if (status) {
      status.textContent = text;
      status.style.color = color;
      status.classList.add('show');
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    showStatus(t('set.saving'), '#9b9bab');
    try {
      const body = {
        name: inputs.name.value.trim(),
        role_title: inputs.role_title.value.trim(),
        tagline_es: (inputs.tagline_es as unknown as HTMLInputElement).value.trim() || null,
        tagline_en: (inputs.tagline_en as unknown as HTMLInputElement).value.trim() || null,
        description_es: (inputs.description_es as unknown as HTMLInputElement).value.trim() || null,
        description_en: (inputs.description_en as unknown as HTMLInputElement).value.trim() || null,
        accent_color: accent.value,
        secondary_color: secondary.value,
        linkedin_url: inputs.linkedin_url.value.trim(),
        github_url: inputs.github_url.value.trim(),
        whatsapp_phone: inputs.whatsapp_phone.value.trim(),
        skills,
      };
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(String(res.status));
      showStatus(t('set.saved'), 'var(--secondary-soft)');
    } catch {
      showStatus(t('set.error'), '#fbbf24');
    } finally {
      saveBtn.disabled = false;
    }
  });

  document.getElementById('resetBtn')?.addEventListener('click', async () => {
    if (!window.confirm(t('set.reset.confirm'))) return;
    try {
      const res = await fetch('/api/settings/reset-defaults', { method: 'POST', credentials: 'same-origin' });
      if (res.ok) {
        fill(await res.json());
        showStatus(t('set.reset.ok'), 'var(--secondary-soft)');
      }
    } catch {
      showStatus(t('set.reset.error'), '#fbbf24');
    }
  });

  // CV upload — replaces /uploads/cv.pdf and updates config.cv_url
  const cvInput = document.getElementById('cv_file') as HTMLInputElement;
  const cvPick = document.getElementById('cvPick') as HTMLButtonElement;
  const cvReplace = document.getElementById('cvReplace') as HTMLButtonElement;
  const cvMeta = document.getElementById('cvMeta')!;
  const cvStatus = document.getElementById('cvStatus');

  function cvShowStatus(text: string, color: string) {
    if (cvStatus) {
      cvStatus.textContent = text;
      cvStatus.style.color = color;
      cvStatus.classList.add('show');
    }
  }

  const settingsData = await (await fetch('/api/settings', { credentials: 'same-origin' })).json();
  function cvRenderCurrent(url: string) {
    cvMeta.textContent = url ? decodeURIComponent(url.split('/').pop()!) : t('set.cv.none');
  }
  cvRenderCurrent(settingsData.cv_url ?? '');

  cvPick.addEventListener('click', () => cvInput.click());
  cvInput.addEventListener('change', () => {
    const file = cvInput.files?.[0];
    if (!file) return;
    const sizeKb = Math.max(1, Math.round(file.size / 1024));
    cvMeta.textContent = `${file.name} · ${sizeKb} KB`;
    cvReplace.hidden = false;
  });

  cvReplace.addEventListener('click', async () => {
    const file = cvInput.files?.[0];
    if (!file) return;
    cvReplace.disabled = true;
    cvShowStatus(t('set.saving'), '#9b9bab');
    try {
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/upload/cv', { method: 'POST', credentials: 'same-origin', body: fd });
      const data = (await res.json()) as { url?: string; filename?: string; detail?: string };
      if (!res.ok || !data.url) throw new Error(data.detail ?? 'error');
      cvRenderCurrent(data.url);
      cvReplace.hidden = true;
      cvInput.value = '';
      cvShowStatus(t('set.cv.ok'), 'var(--secondary-soft)');
    } catch (err) {
      cvShowStatus(err instanceof Error && err.message && err.message !== 'error' ? err.message : t('set.cv.error'), '#fbbf24');
    } finally {
      cvReplace.disabled = false;
    }
  });
</script>
